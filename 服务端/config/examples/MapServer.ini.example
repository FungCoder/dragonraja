; Single-host installation example. Set your own database credentials and paths.

[network]
path=D:\DragonRajaServer\resources
mapname=MA-IN

[server_info]
own_server_ip_for_server=127.0.0.1
own_server_port_for_server=5000
own_server_ip_for_user=127.0.0.1
own_server_port_for_user=5000
primary_proxy_server_ip=127.0.0.1
primary_proxy_server_port=3000
secondary_proxy_server_ip=127.0.0.1
secondary_proxy_server_port=3000

[Option]
DRAGON_MAX_CONNECTIONS=100
LogPath=D:\DragonRajaServer\logs
UsingSavedMapServerStatus=0
DisconnectAccelatorUser=0

[nation_set]
nation_name=CHINA
BETA_SERVER=0

[chr_log_server]
chr_log_start_login=1
chr_log_start_logout=1
chr_log_start_levelup=1

[db_account]
dragon_id=
dragon_pw=
total_id=
total_pw=
chrlog_id=
chrlog_pw=

[kein]
GetPortFlag=0

[mysql_conn]
driver=MySQL ODBC 9.7 ANSI Driver
server=127.0.0.1
port=3306
option=3
use_legacy_id_password=0
