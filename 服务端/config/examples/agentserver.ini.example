; Single-host installation example. Set your own database credentials and paths.

[NATION_SET]
nation_name=CHINA
BETA_SERVER=1

[server_info]
path=D:\DragonRajaServer\resources
own_server_ip_for_server=127.0.0.1
own_server_port_for_server=7001
own_server_ip_for_user=127.0.0.1
own_server_port_for_user=7000
primary_proxy_server_ip=127.0.0.1
primary_proxy_server_port=3000

[server_list]
server_num=1

[server_set_info]
own_server_set_number=1
default_max_user_can_login_per_sec=10
default_max_user_can_login=1500

[external_server_info]
num_of_external_servers=0

[agent_info]
port=7000
max_user_num=1500

[PayInfo]
LOG_SendPayFormatMessage=0
LOG_RecvResponsMessage=0
